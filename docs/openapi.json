{
  "openapi": "3.1.0",
  "info": {
    "title": "MediKiosk",
    "version": "0.2.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "Check system health including database connectivity.\n\nPerforms a lightweight ``SELECT 1`` probe against the configured\ndatabase engine. Never raises \u2014 a DB failure is surfaced as\n``\"database\": \"error\"`` in the response body so load balancers can\nstill parse the JSON.\n\nArgs:\n    engine: Async SQLAlchemy engine (injected).\n\nReturns:\n    dict: Health payload with keys ``status``, ``version``,\n          ``database``.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/intake/start": {
      "post": {
        "tags": [
          "intake"
        ],
        "summary": "Start Session",
        "description": "Start a new multi-tenant patient intake session.\n\nCreates a ``SessionState`` record and writes an audit event.\nPHI is never included in the response \u2014 only the opaque ``session_id``\nis returned to the caller.\n\nArgs:\n    body: Session configuration supplied by the kiosk.\n    current_user: Authenticated principal (injected).\n    session_svc: Session lifecycle service (injected).\n    intake_svc: Intake processing service (injected).\n\nReturns:\n    StartSessionResponse: Created session metadata.\n\nRaises:\n    HTTPException 403: ConsentRequiredError / ConsentError.\n    HTTPException 422: Domain ValidationError.\n    HTTPException 500: Any other MediKioskError.",
        "operationId": "start_session_api_intake_start_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/intake/respond": {
      "post": {
        "tags": [
          "intake"
        ],
        "summary": "Respond",
        "description": "Process a patient response and return the next question or triage alert.\n\nValidates session existence and liveness via SessionService. Full\nLLM-based question generation is deferred to Wave 6 (IntakeService).\nA placeholder next question is returned for now.\n\nSECURITY: ``body.response_text`` is PHI and MUST NOT be logged.\nOnly ``session_id`` is recorded in structured logs.\n\nArgs:\n    body: Patient response payload.\n    current_user: Authenticated principal (injected).\n    session_svc: Session lifecycle service (injected).\n    intake_svc: The actual IntakeService.\n\nReturns:\n    RespondResponse: Updated progress, any triage alerts, and next question.",
        "operationId": "respond_api_intake_respond_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespondRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespondResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/session/purge": {
      "post": {
        "tags": [
          "intake"
        ],
        "summary": "Purge Session",
        "description": "Hard-delete a session record (DPDP Right-to-Erasure).\n\nPermanently removes all session data from the store and writes a\ntamper-evident audit event for compliance. This operation is\nirreversible.\n\nAccepted roles: ``Kiosk_Device``, ``Triage_Nurse``.\n\nArgs:\n    body: Purge request with session_id and reason.\n    current_user: Authenticated principal with purge permission (injected).\n    session_svc: Session lifecycle service (injected).\n\nReturns:\n    PurgeResponse: Confirmation that the session was purged.\n\nRaises:\n    HTTPException 404: SessionNotFoundError.\n    HTTPException 500: Any other MediKioskError.",
        "operationId": "purge_session_api_session_purge_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurgeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurgeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
