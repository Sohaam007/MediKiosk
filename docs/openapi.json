      },
      "QueueEntry": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "department_id": {
            "type": "string",
            "title": "Department Id"
          },
          "triage_priority": {
            "type": "string",
            "title": "Triage Priority",
            "description": "critical|urgent|normal"
          },
          "wait_time_seconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Wait Time Seconds"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "department_id",
          "triage_priority",
          "wait_time_seconds",
          "status"
        ],
        "title": "QueueEntry",
        "description": "A single entry in the clinician triage queue.\n\nAttributes:\n    session_id: Opaque session reference (no PHI).\n    department_id: Clinical department this entry belongs to.\n    triage_priority: Urgency level: critical|urgent|normal.\n    wait_time_seconds: How long the patient has been waiting.\n    status: Current lifecycle status of the session."
      },
      "QueueResponse": {
        "properties": {
          "department_id": {
            "type": "string",
            "title": "Department Id"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/QueueEntry"
            },
            "type": "array",
            "title": "Entries"
          },
          "total_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Count"
          }
        },
        "type": "object",
        "required": [
          "department_id",
          "entries",
          "total_count"
        ],
        "title": "QueueResponse",
        "description": "Response body for GET /api/clinician/queue.\n\nAttributes:\n    department_id: The department whose queue is returned.\n    entries: Ordered list of queue entries (highest priority first).\n    total_count: Total number of active sessions in the queue."
      },
      "RespondRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "response_text": {
            "type": "string",
            "maxLength": 2000,
            "title": "Response Text",
            "description": "Patient response. PHI \u2014 never log."
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Input confidence score",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "response_text"
        ],
        "title": "RespondRequest",
        "description": "Request body for POST /api/intake/respond.\n\nAttributes:\n    session_id: Existing session to continue.\n    response_text: Patient's answer text. Contains PHI \u2014 never log.\n    confidence: ASR or input confidence score [0.0, 1.0]."
      },
      "RespondResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "intake_progress": {
            "type": "number",
            "title": "Intake Progress"
          },
          "human_fallback_triggered": {
            "type": "boolean",
            "title": "Human Fallback Triggered"
          },
          "triage_alerts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
